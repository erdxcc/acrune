# Copy to .env (or run `pnpm keygen`, which writes one with fresh secrets).
SOLANA_RPC_URL=https://api.devnet.solana.com
# 64-byte keypair as a JSON array, e.g. from `pnpm keygen`. Pays fees and owns the collection.
RELAYER_SECRET_KEY=
# Random strings, 32+ characters each.
ASSET_SEED_SECRET=
TOKEN_HMAC_SECRET=
# Printed by `pnpm collection`.
COLLECTION_ADDRESS=
# Public URL of this relayer; NFT metadata and images point here.
PUBLIC_BASE_URL=http://localhost:8787
GAME_URL=https://idosgames.com
IDOS_API_BASE=https://api.idosgames.com
# iDos title IDs this relayer serves, comma-separated, e.g. ABCD1234,ABCD1234-DEV
ALLOWED_TITLES=
